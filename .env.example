# Neon Postgres — pooled connection (used at runtime by the app)
DATABASE_URL="your_database_url"

# Neon Postgres — direct (unpooled) connection (used by Prisma Migrate)
DIRECT_URL="your_direct_url"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# App
NEXT_PUBLIC_APP_NAME="Grading App"