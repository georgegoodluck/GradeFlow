generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model School {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logoUrl   String?
  address   String?
  motto     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           User[]
  students        Student[]
  classes         Class[]
  subjects        Subject[]
  teacherSubjects TeacherSubject[]
  terms           Term[]
  scores          Score[]
}

enum Role {
  OWNER
  ADMIN
  TEACHER
  STUDENT
}

model User {
  id           String   @id @default(cuid())
  schoolId     String
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(TEACHER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  school          School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student         Student?
  teacherSubjects TeacherSubject[]

  @@index([schoolId])
}

model Student {
  id          String   @id @default(cuid())
  schoolId    String
  userId      String?  @unique
  firstName   String
  lastName    String
  admissionNo String
  classId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  class  Class   @relation(fields: [classId], references: [id], onDelete: Restrict)
  scores Score[]

  @@unique([schoolId, admissionNo])
  @@index([schoolId])
  @@index([classId])
}

model Class {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school          School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  students        Student[]
  teacherSubjects TeacherSubject[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

model Subject {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school          School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacherSubjects TeacherSubject[]
  scores          Score[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

model TeacherSubject {
  id        String   @id @default(cuid())
  schoolId  String
  teacherId String
  subjectId String
  classId   String
  createdAt DateTime @default(now())

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacher User    @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([teacherId, subjectId, classId])
  @@index([schoolId])
}

model Term {
  id        String   @id @default(cuid())
  schoolId  String
  session   String
  name      String
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  scores Score[]

  @@unique([schoolId, session, name])
  @@index([schoolId])
}

model Score {
  id        String   @id @default(cuid())
  schoolId  String
  studentId String
  subjectId String
  termId    String
  ca1       Int      @default(0)
  ca2       Int      @default(0)
  ca3       Int      @default(0)
  exam      Int      @default(0)

  // Computed fields
  caAverage Float    @default(0)
  total     Float    @default(0)
  grade     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  term    Term    @relation(fields: [termId], references: [id], onDelete: Cascade)

  @@unique([studentId, subjectId, termId])
  @@index([schoolId])
  @@index([termId])
}