generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model School {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logoUrl   String?
  address   String?
  motto     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users    User[]
  students Student[]
  classes  Class[]
  subjects Subject[]
}

enum Role {
  OWNER
  ADMIN
  TEACHER
  STUDENT
}

model User {
  id           String   @id @default(cuid())
  schoolId     String
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(TEACHER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  school  School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student Student?

  @@index([schoolId])
}

model Student {
  id          String   @id @default(cuid())
  schoolId    String
  userId      String?  @unique
  firstName   String
  lastName    String
  admissionNo String
  classId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)
  class  Class  @relation(fields: [classId], references: [id], onDelete: Restrict)

  @@unique([schoolId, admissionNo])
  @@index([schoolId])
  @@index([classId])
}

model Class {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school   School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  students Student[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

model Subject {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, name])
  @@index([schoolId])
}