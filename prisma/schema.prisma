generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model School {
  id      String  @id @default(cuid())
  name    String
  slug    String  @unique
  isSetup Boolean @default(false)

  staffs          Staff[]
  students        Student[]
  classes         Class[]
  subjects        Subject[]
  terms           Term[]
  scores          Score[]
  teacherSubjects TeacherSubject[]
}

enum Role {
  OWNER
  ADMIN
  TEACHER
}

model Staff {
  id           String @id @default(cuid())
  schoolId     String
  email        String @unique
  passwordHash String
  firstName    String
  lastName     String
  role         Role   @default(TEACHER)

  school          School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacherSubjects TeacherSubject[]
}

model Student {
  id            String  @id @default(cuid())
  schoolId      String
  email         String  @unique
  passwordHash  String
  firstName     String
  lastName      String
  admissionNo   String
  classId       String
  overallPosition Int?

  school School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class  Class   @relation(fields: [classId], references: [id], onDelete: Restrict)
  scores Score[]

  @@unique([schoolId, admissionNo])
}

model Class {
  id       String @id @default(cuid())
  schoolId String
  name     String

  school          School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  students        Student[]
  teacherSubjects TeacherSubject[]

  @@unique([schoolId, name])
}

model Subject {
  id       String @id @default(cuid())
  schoolId String
  name     String

  school          School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  scores          Score[]
  teacherSubjects TeacherSubject[]

  @@unique([schoolId, name])
}

model TeacherSubject {
  id        String @id @default(cuid())
  schoolId  String
  staffId   String
  subjectId String
  classId   String

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  staff   Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([staffId, subjectId, classId])
}

model Term {
  id       String  @id @default(cuid())
  schoolId String
  session  String
  name     String
  isActive Boolean @default(false)

  school School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  scores Score[]

  @@unique([schoolId, session, name])
}

model Score {
  id            String  @id @default(cuid())
  schoolId      String
  studentId     String
  subjectId     String
  termId        String
  ca1           Int     @default(0)
  ca2           Int     @default(0)
  ca3           Int     @default(0)
  exam          Int     @default(0)
  caAverage     Float   @default(0)
  total         Float   @default(0)
  grade         String?
  subjectRank   Int?

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  term    Term    @relation(fields: [termId], references: [id], onDelete: Cascade)

  @@unique([studentId, subjectId, termId])
}